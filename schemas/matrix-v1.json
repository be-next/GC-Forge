{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matrix",
  "description": "Top-level matrix document.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/MatrixSpec"
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "$defs": {
    "MatrixSpec": {
      "type": "object",
      "properties": {
        "axes": {
          "description": "Each entry is `<dotted.path>: [values]`. Iteration order is preserved\nso users can predict cell order.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": true
          },
          "default": {}
        },
        "base": {
          "description": "Path to the base scenario YAML; can be relative to the matrix file.",
          "type": "string"
        },
        "filters": {
          "description": "Cells matching any filter are excluded. A filter is a map of\n`<dotted.path>: <value>` — all entries must match for the filter to fire.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "seeds": {
          "description": "Seeds to enumerate. When empty, the base scenario's seed is used once.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "base"
      ]
    }
  }
}
