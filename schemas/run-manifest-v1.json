{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "description": "Top-level run manifest document.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "expected_invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExpectedInvariantRecord"
      }
    },
    "expected_phenomena": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jvm": {
      "$ref": "#/$defs/JvmRecord"
    },
    "kind": {
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/OutputRecord"
    },
    "reproducibility": {
      "$ref": "#/$defs/ReproducibilityRecord"
    },
    "run": {
      "$ref": "#/$defs/RunMeta"
    },
    "scenario": {
      "$ref": "#/$defs/ScenarioRecord"
    },
    "validation": {
      "$ref": "#/$defs/ValidationRecord"
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "run",
    "scenario",
    "jvm",
    "reproducibility",
    "output",
    "validation"
  ],
  "$defs": {
    "ByteSize": {
      "description": "A size in bytes, parsed from JVM-style strings (`\"2g\"`, `\"512m\"`, `\"1024\"`).",
      "type": "string"
    },
    "Distribution": {
      "type": "string",
      "enum": [
        "jdk",
        "jre"
      ]
    },
    "Duration": {
      "description": "A wall-clock duration, parsed from human-friendly suffix forms or\nminimal ISO-8601.",
      "type": "string"
    },
    "ExitStatusRecord": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "success"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "format": "int32"
            },
            "kind": {
              "type": "string",
              "const": "failure"
            }
          },
          "required": [
            "kind",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "oom"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeout"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "signaled"
            },
            "signal": {
              "type": "integer",
              "format": "int32"
            }
          },
          "required": [
            "kind",
            "signal"
          ]
        }
      ]
    },
    "ExpectedClause": {
      "type": "object",
      "properties": {
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InvariantRule"
          }
        },
        "phenomena": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ExpectedInvariantRecord": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string"
        },
        "threshold": {
          "description": "Free-form (number/string/array) — schema describes a generic value.",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "rule"
      ]
    },
    "GcAlgorithm": {
      "type": "string",
      "enum": [
        "G1",
        "ZGC",
        "Parallel",
        "Shenandoah",
        "Serial",
        "Epsilon"
      ]
    },
    "GcOptions": {
      "type": "object",
      "properties": {
        "generational": {
          "description": "Generational mode for ZGC. Defaults to `None` at parse time; the runner\napplies the algorithm-specific default (`true` for ZGC on JDK 21+).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "heap": {
          "$ref": "#/$defs/HeapConfig"
        },
        "ihop_percent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "pause_target_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "region_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "heap"
      ]
    },
    "GcSpec": {
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/GcAlgorithm"
        },
        "extra_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log_format": {
          "$ref": "#/$defs/LogFormat",
          "default": "unified"
        },
        "options": {
          "$ref": "#/$defs/GcOptions",
          "default": {
            "heap": {
              "max": "0",
              "min": "0"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "algorithm"
      ]
    },
    "HeapConfig": {
      "type": "object",
      "properties": {
        "max": {
          "$ref": "#/$defs/ByteSize"
        },
        "min": {
          "$ref": "#/$defs/ByteSize"
        },
        "new_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteSize"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "HostMeta": {
      "type": "object",
      "properties": {
        "arch": {
          "type": "string"
        },
        "container": {
          "description": "`docker:<image-tag>` or `native:<jdk-path>`.",
          "type": "string"
        },
        "cpu_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "os": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "cpu_count",
        "container"
      ]
    },
    "InvariantRule": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string"
        },
        "threshold": {
          "description": "Free-form threshold (number/string/array depending on the rule).",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "rule"
      ]
    },
    "JvmRecord": {
      "type": "object",
      "properties": {
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vendor": {
          "type": "string"
        },
        "version": {
          "description": "Human-readable version string from `java -version`, when available.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "vendor",
        "flags"
      ]
    },
    "JvmSpec": {
      "type": "object",
      "properties": {
        "distribution": {
          "$ref": "#/$defs/Distribution",
          "default": "jdk"
        },
        "extra_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "major": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "vendor": {
          "$ref": "#/$defs/JvmVendor"
        }
      },
      "additionalProperties": false,
      "required": [
        "vendor",
        "major"
      ]
    },
    "JvmVendor": {
      "type": "string",
      "enum": [
        "temurin",
        "corretto",
        "graalvm",
        "openj9"
      ]
    },
    "LogFormat": {
      "type": "string",
      "enum": [
        "unified",
        "legacy"
      ]
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "default": "1.0.0"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "OutputRecord": {
      "type": "object",
      "properties": {
        "log_path": {
          "type": "string"
        },
        "log_sha256": {
          "type": "string"
        },
        "log_size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "log_path",
        "log_sha256",
        "log_size_bytes"
      ]
    },
    "OutputSpec": {
      "type": "object",
      "properties": {
        "capture_jfr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "log_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RegimeSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "parameters": {
          "description": "Free-form parameters; schema describes a generic JSON object.",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "ReproducibilityRecord": {
      "type": "object",
      "properties": {
        "gc_forge_version": {
          "type": "string"
        },
        "seed": {
          "description": "The seed as a hex string, e.g. `\"0xC0FFEE\"`.",
          "type": "string"
        },
        "workload_jar_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "seed",
        "workload_jar_sha256",
        "gc_forge_version"
      ]
    },
    "RunMeta": {
      "type": "object",
      "properties": {
        "duration_actual": {
          "$ref": "#/$defs/Duration"
        },
        "ended_at": {
          "type": "string"
        },
        "exit_status": {
          "$ref": "#/$defs/ExitStatusRecord"
        },
        "host": {
          "$ref": "#/$defs/HostMeta"
        },
        "id": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "started_at",
        "ended_at",
        "duration_actual",
        "exit_status",
        "host"
      ]
    },
    "Scenario": {
      "description": "Top-level scenario document.",
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "extends": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "$ref": "#/$defs/Spec"
        }
      },
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ]
    },
    "ScenarioRecord": {
      "type": "object",
      "properties": {
        "resolved": {
          "$ref": "#/$defs/Scenario"
        },
        "source_path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "resolved"
      ]
    },
    "Seed": {
      "description": "Seed, accepted as either a non-negative integer or a hex string `\"0xC0FFEE\"`.",
      "type": "string"
    },
    "Spec": {
      "type": "object",
      "properties": {
        "duration": {
          "$ref": "#/$defs/Duration"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpectedClause"
            },
            {
              "type": "null"
            }
          ]
        },
        "gc": {
          "$ref": "#/$defs/GcSpec"
        },
        "jvm": {
          "$ref": "#/$defs/JvmSpec"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "regime": {
          "$ref": "#/$defs/RegimeSpec"
        },
        "seed": {
          "$ref": "#/$defs/Seed"
        },
        "warmup": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "jvm",
        "gc",
        "regime",
        "duration",
        "seed"
      ]
    },
    "ValidationRecord": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationResult"
          }
        },
        "status": {
          "$ref": "#/$defs/ValidationStatus"
        },
        "validated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "validator_version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "validator_version"
      ]
    },
    "ValidationResult": {
      "type": "object",
      "properties": {
        "observed": true,
        "passed": {
          "type": "boolean"
        },
        "rule": {
          "type": "string"
        },
        "threshold": true
      },
      "additionalProperties": false,
      "required": [
        "rule",
        "observed",
        "threshold",
        "passed"
      ]
    },
    "ValidationStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped"
      ]
    }
  }
}
