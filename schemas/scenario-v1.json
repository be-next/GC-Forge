{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "description": "Top-level scenario document.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/Spec"
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "$defs": {
    "ByteSize": {
      "description": "A size in bytes, parsed from JVM-style strings (`\"2g\"`, `\"512m\"`, `\"1024\"`).",
      "type": "string"
    },
    "Distribution": {
      "type": "string",
      "enum": [
        "jdk",
        "jre"
      ]
    },
    "Duration": {
      "description": "A wall-clock duration, parsed from human-friendly suffix forms or\nminimal ISO-8601.",
      "type": "string"
    },
    "ExpectedClause": {
      "type": "object",
      "properties": {
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InvariantRule"
          }
        },
        "phenomena": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "GcAlgorithm": {
      "type": "string",
      "enum": [
        "G1",
        "ZGC",
        "Parallel",
        "Shenandoah",
        "Serial",
        "Epsilon"
      ]
    },
    "GcOptions": {
      "type": "object",
      "properties": {
        "generational": {
          "description": "Generational mode for ZGC. Defaults to `None` at parse time; the runner\napplies the algorithm-specific default (`true` for ZGC on JDK 21+).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "heap": {
          "$ref": "#/$defs/HeapConfig"
        },
        "ihop_percent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "pause_target_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "region_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "heap"
      ]
    },
    "GcSpec": {
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/GcAlgorithm"
        },
        "extra_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log_format": {
          "$ref": "#/$defs/LogFormat",
          "default": "unified"
        },
        "options": {
          "$ref": "#/$defs/GcOptions",
          "default": {
            "heap": {
              "max": "0",
              "min": "0"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "algorithm"
      ]
    },
    "HeapConfig": {
      "type": "object",
      "properties": {
        "max": {
          "$ref": "#/$defs/ByteSize"
        },
        "min": {
          "$ref": "#/$defs/ByteSize"
        },
        "new_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteSize"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "InvariantRule": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string"
        },
        "threshold": {
          "description": "Free-form threshold (number/string/array depending on the rule).",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "rule"
      ]
    },
    "JvmSpec": {
      "type": "object",
      "properties": {
        "distribution": {
          "$ref": "#/$defs/Distribution",
          "default": "jdk"
        },
        "extra_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "major": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "vendor": {
          "$ref": "#/$defs/JvmVendor"
        }
      },
      "additionalProperties": false,
      "required": [
        "vendor",
        "major"
      ]
    },
    "JvmVendor": {
      "type": "string",
      "enum": [
        "temurin",
        "corretto",
        "graalvm",
        "openj9"
      ]
    },
    "LogFormat": {
      "type": "string",
      "enum": [
        "unified",
        "legacy"
      ]
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "default": "1.0.0"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "OutputSpec": {
      "type": "object",
      "properties": {
        "capture_jfr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "log_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RegimeSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "parameters": {
          "description": "Free-form parameters; schema describes a generic JSON object.",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "Seed": {
      "description": "Seed, accepted as either a non-negative integer or a hex string `\"0xC0FFEE\"`.",
      "type": "string"
    },
    "Spec": {
      "type": "object",
      "properties": {
        "duration": {
          "$ref": "#/$defs/Duration"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpectedClause"
            },
            {
              "type": "null"
            }
          ]
        },
        "gc": {
          "$ref": "#/$defs/GcSpec"
        },
        "jvm": {
          "$ref": "#/$defs/JvmSpec"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "regime": {
          "$ref": "#/$defs/RegimeSpec"
        },
        "seed": {
          "$ref": "#/$defs/Seed"
        },
        "warmup": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "jvm",
        "gc",
        "regime",
        "duration",
        "seed"
      ]
    }
  }
}
