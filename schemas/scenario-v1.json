{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "description": "Top-level scenario document.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "$ref": "#/definitions/Metadata"
    },
    "spec": {
      "$ref": "#/definitions/Spec"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Spec": {
      "type": "object",
      "required": [
        "duration",
        "gc",
        "jvm",
        "regime",
        "seed"
      ],
      "properties": {
        "jvm": {
          "$ref": "#/definitions/JvmSpec"
        },
        "gc": {
          "$ref": "#/definitions/GcSpec"
        },
        "regime": {
          "$ref": "#/definitions/RegimeSpec"
        },
        "duration": {
          "$ref": "#/definitions/Duration"
        },
        "warmup": {
          "anyOf": [
            {
              "$ref": "#/definitions/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "$ref": "#/definitions/Seed"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/definitions/OutputSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/definitions/ExpectedClause"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "JvmSpec": {
      "type": "object",
      "required": [
        "major",
        "vendor"
      ],
      "properties": {
        "vendor": {
          "$ref": "#/definitions/JvmVendor"
        },
        "major": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "distribution": {
          "default": "jdk",
          "allOf": [
            {
              "$ref": "#/definitions/Distribution"
            }
          ]
        },
        "extra_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "JvmVendor": {
      "type": "string",
      "enum": [
        "temurin",
        "corretto",
        "graalvm",
        "openj9"
      ]
    },
    "Distribution": {
      "type": "string",
      "enum": [
        "jdk",
        "jre"
      ]
    },
    "GcSpec": {
      "type": "object",
      "required": [
        "algorithm"
      ],
      "properties": {
        "algorithm": {
          "$ref": "#/definitions/GcAlgorithm"
        },
        "options": {
          "default": {
            "heap": {
              "max": "0",
              "min": "0"
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/GcOptions"
            }
          ]
        },
        "extra_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log_format": {
          "default": "unified",
          "allOf": [
            {
              "$ref": "#/definitions/LogFormat"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GcAlgorithm": {
      "type": "string",
      "enum": [
        "G1",
        "ZGC",
        "Parallel",
        "Shenandoah",
        "Serial",
        "Epsilon"
      ]
    },
    "GcOptions": {
      "type": "object",
      "required": [
        "heap"
      ],
      "properties": {
        "generational": {
          "description": "Generational mode for ZGC. Defaults to `None` at parse time; the runner applies the algorithm-specific default (`true` for ZGC on JDK 21+).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "heap": {
          "$ref": "#/definitions/HeapConfig"
        },
        "pause_target_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "region_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "ihop_percent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HeapConfig": {
      "type": "object",
      "required": [
        "max",
        "min"
      ],
      "properties": {
        "min": {
          "$ref": "#/definitions/ByteSize"
        },
        "max": {
          "$ref": "#/definitions/ByteSize"
        },
        "new_size": {
          "anyOf": [
            {
              "$ref": "#/definitions/ByteSize"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ByteSize": {
      "description": "A size in bytes, parsed from JVM-style strings (`\"2g\"`, `\"512m\"`, `\"1024\"`).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "LogFormat": {
      "type": "string",
      "enum": [
        "unified",
        "legacy"
      ]
    },
    "RegimeSpec": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "parameters": {
          "description": "Free-form parameters; schema describes a generic JSON object.",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Duration": {
      "description": "A wall-clock duration, parsed from human-friendly suffix forms or minimal ISO-8601.",
      "allOf": [
        {
          "$ref": "#/definitions/Duration2"
        }
      ]
    },
    "Duration2": {
      "type": "object",
      "required": [
        "nanos",
        "secs"
      ],
      "properties": {
        "secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "Seed": {
      "description": "Seed, accepted as either a non-negative integer or a hex string `\"0xC0FFEE\"`.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "OutputSpec": {
      "type": "object",
      "properties": {
        "log_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "capture_jfr": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ExpectedClause": {
      "type": "object",
      "properties": {
        "phenomena": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvariantRule"
          }
        }
      },
      "additionalProperties": false
    },
    "InvariantRule": {
      "type": "object",
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "threshold": {
          "description": "Free-form threshold (number/string/array depending on the rule).",
          "default": null
        }
      },
      "additionalProperties": false
    }
  }
}
